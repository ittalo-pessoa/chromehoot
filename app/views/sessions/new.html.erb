<section class="card narrow"><span class="auth-emblem" aria-hidden="true">⚑</span><p class="eyebrow">ÁREA DO PROFESSOR</p><h1>Bem-vindo de volta.</h1><%= form_with url: login_path do |f| %><%= f.label :email, 'E-mail' %><%= f.email_field :email, required: true, autocomplete: 'username' %><%= f.label :password, 'Senha' %><%= f.password_field :password, required: true, autocomplete: 'current-password' %><%= f.submit 'Entrar' %><% end %><p class="auth-switch">Ainda não tem uma conta? <%= link_to 'Criar conta de professor', signup_path %></p></section>
