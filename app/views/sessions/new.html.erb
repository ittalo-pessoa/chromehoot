<section class="card narrow"><p class="eyebrow">ÁREA DO PROFESSOR</p><h1>Bem-vindo de volta.</h1><%= form_with url: login_path do |f| %><%= f.label :email, 'E-mail' %><%= f.email_field :email, required: true, autocomplete: 'username' %><%= f.label :password, 'Senha' %><%= f.password_field :password, required: true, autocomplete: 'current-password' %><%= f.submit 'Entrar' %><% end %><p>As contas são criadas pelo administrador local da escola.</p></section>
