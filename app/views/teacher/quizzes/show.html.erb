<div class="heading"><div><p class="eyebrow"><%= @quiz.subject %></p><h1><%= @quiz.title %></h1><p><%= @quiz.description %></p></div><%= button_to 'Criar sala →', teacher_game_sessions_path, params: { quiz_id: @quiz.id } %></div>
<div class="actions"><%= link_to 'Editar informações', edit_teacher_quiz_path(@quiz), class: 'button secondary' %><%= link_to '+ Adicionar questão', new_teacher_quiz_question_path(@quiz), class: 'button' %><%= button_to 'Duplicar', duplicate_teacher_quiz_path(@quiz), class: 'secondary' %><%= button_to 'Arquivar', archive_teacher_quiz_path(@quiz), method: :patch, class: 'secondary', data: { turbo_confirm: 'Arquivar este quiz? O histórico será preservado.' } %><%= button_to 'Excluir quiz', teacher_quiz_path(@quiz), method: :delete, class: 'danger-button', data: { turbo_confirm: 'Excluir este quiz? Sem partidas, ele será apagado. Se houver partidas, será removido do painel preservando o histórico.' } %></div>
<% @quiz.questions.each_with_index do |question, index| %><article class="card"><p class="eyebrow">QUESTÃO <%= index + 1 %> · <%= question.time_limit_seconds %> SEGUNDOS</p><h2><%= question.statement %></h2><%= image_tag question.image, class: 'question-image', alt: 'Imagem da questão' if question.image.attached? %><ol type="A"><% question.choices.each do |choice| %><li><%= choice.text %> <%= '✓ Correta' if choice.correct? %></li><% end %></ol><div class="actions"><%= link_to 'Editar', edit_teacher_quiz_question_path(@quiz, question) %><%= button_to '↑ Subir', move_teacher_quiz_question_path(@quiz, question), method: :patch, params: { direction: 'up' }, class: 'secondary' %><%= button_to '↓ Descer', move_teacher_quiz_question_path(@quiz, question), method: :patch, params: { direction: 'down' }, class: 'secondary' %><%= button_to 'Excluir', teacher_quiz_question_path(@quiz, question), method: :delete, class: 'secondary', data: { turbo_confirm: 'Excluir esta questão?' } %></div></article><% end %>
<% if @quiz.questions.empty? %><div class="card">Adicione pelo menos uma questão válida antes de criar uma sala.</div><% end %>
