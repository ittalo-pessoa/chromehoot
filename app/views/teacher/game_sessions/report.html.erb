<% total = @game.participants.count; answers = Answer.where(round_id: @rounds.select(:id)); answered = answers.count; hits = answers.where(correct: true).count; rate = answered.zero? ? nil : (hits * 100.0 / answered).round; average = total.zero? ? 0 : (@ranking.sum { |r| r[:points] } / total.to_f).round %>
<div class="heading"><div><p class="eyebrow">RESULTADOS DA ATIVIDADE · SALA <%= @game.join_code %></p><h1><%= @game.quiz.title %></h1><p>Realizada em <%= @game.created_at.strftime('%d/%m/%Y') %> · <%= @game.quiz.subject %></p></div><%= link_to '↓ Exportar CSV', report_teacher_game_session_path(@game, format: :csv), class: 'button' %></div>
<div class="report-stats"><div class="metric blue"><span>Participantes</span><strong><%= total %></strong><small>Inclui participantes removidos</small></div><div class="metric green"><span>Taxa de acerto</span><strong><%= rate ? "#{rate}%" : '—' %></strong><small>Das respostas recebidas</small></div><div class="metric amber"><span>Questões realizadas</span><strong><%= @rounds.size %></strong><small>Rodadas que foram abertas</small></div><div class="metric violet"><span>Pontuação média</span><strong><%= average %></strong><small>Pontos por participante</small></div></div>
<section class="card"><div class="section-heading"><h2>Desempenho por questão</h2><span class="subject-badge">Acertos sobre participantes</span></div><% if @rounds.any? %><div class="report-chart" role="img" aria-label="Percentual de participantes que acertaram cada questão. Valores detalhados abaixo."><% @rounds.each_with_index do |round, index| %><% percent = total.zero? ? 0 : (round.answers.where(correct: true).count * 100.0 / total).round %><div class="chart-column"><span class="chart-value"><%= percent %>%</span><div class="chart-bar" style="height:<%= percent * 1.2 %>px"></div><span class="chart-label">Q<%= index + 1 %></span></div><% end %></div><% else %><p>As informações aparecem quando a primeira questão for aberta.</p><% end %></section>
<div class="section-heading"><h2>Placar da turma</h2><span class="subject-badge"><%= total %> participantes</span></div>
<div class="card table-wrap"><table><thead><tr><th>Colocação</th><th>Participante</th><th>Pontos</th><th>Acertos</th><th>Erros</th><th>Ausências</th></tr></thead><tbody><% @ranking.each do |row| %><% items = row[:participant].answers.where(round_id: @rounds.select(:id)) %><tr><td><%= row[:rank] %>º</td><td><%= row[:nickname] %><%= ' (removido)' if row[:participant].removed_at? %></td><td><%= row[:points] %></td><td><%= row[:correct] %></td><td><%= items.where(correct: false).count %></td><td><%= @rounds.size - items.count %></td></tr><% end %></tbody></table></div>
<h2>Questão por questão</h2><% @rounds.each_with_index do |round, index| %><% correct = round.answers.where(correct: true).count; wrong = round.answers.where(correct: false).count %><section class="card question-report"><span class="step blue"><%= index + 1 %></span><div><h3><%= round.session_question.statement %></h3><p><%= correct %> acertos · <%= wrong %> erros · <%= total - correct - wrong %> ausências</p></div><span class="question-rate"><%= total.zero? ? 0 : (correct * 100.0 / total).round %>%</span></section><% end %>
