<% projection = action_name == 'projector' %>
<div class="heading"><div><p class="eyebrow"><%= projection ? 'TELA DE PROJEÇÃO' : 'CONTROLE DA PARTIDA' %></p><h1><%= @game.quiz.title %></h1><p>Uma pergunta de cada vez. Uma turma aprendendo junto.</p></div><div class="room-pin">Código da sala<strong class="room-code"><%= @game.join_code %></strong></div></div>
<% if projection %><div class="actions"><%= link_to 'Ir para o controle da partida →', teacher_game_session_path(@game), class: 'button' %><p>Para iniciar e abrir questões, use o controle da partida.</p></div><% else %><div class="actions"><%= link_to 'Abrir projeção ↗', projector_teacher_game_session_path(@game), target: '_blank', rel: 'noopener', class: 'button secondary' %><%= link_to 'Ver relatório ↗', report_teacher_game_session_path(@game), class: 'button secondary' %></div><% end %>
<div data-controller="game" data-game-url-value="<%= state_teacher_game_session_path(@game) %>" data-game-role-value="<%= projection ? 'projector' : 'teacher' %>">
  <%= render 'application/music', game: @game %>
  <div data-game-target="status" class="notice" role="status">Conectando à sala…</div>
  <div class="<%= 'game-shell' unless projection %>"><div class="game-stage"><section data-game-target="content" class="card" aria-live="polite"></section></div>
  <% unless projection %><aside class="game-sidebar"><section class="card"><h2>Conduzir a turma</h2><p>As ações ficam disponíveis conforme a partida avança.</p><div class="actions"><% { start: 'Iniciar partida', open_question: 'Abrir questão', close_question: 'Fechar respostas', reveal: 'Revelar resultado', advance: 'Próxima questão', finish: 'Finalizar partida', cancel: 'Cancelar partida' }.each do |command, label| %><%= form_with url: command_teacher_game_session_path(@game), data: { game_command: command } do |f| %><%= f.hidden_field :command, value: command %><%= f.hidden_field :round_id, value: @game.current_round&.id, data: { game_round: true } %><%= f.submit label, class: 'secondary', data: { turbo_confirm: (%i[finish cancel].include?(command) ? 'Encerrar a partida?' : nil) } %><% end %><% end %></div></section>
  <section class="card"><h2>Gerenciar participantes</h2><% @game.participants.where(removed_at: nil).each do |participant| %><div class="participant"><span><%= participant.nickname %></span><%= button_to 'Remover', remove_participant_teacher_game_session_path(@game), method: :patch, params: { participant_id: participant.id }, class: 'quiet', data: { turbo_confirm: 'Remover este participante?' } %></div><% end %><p>Atualize a página para gerenciar novas entradas. A lista da sala sincroniza automaticamente.</p></section></aside><% end %>
  </div>
</div>
