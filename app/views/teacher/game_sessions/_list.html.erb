<div class="card table-wrap"><table><thead><tr><th>Quiz</th><th>Código</th><th>Estado</th><th>Data</th><th>Ações</th></tr></thead><tbody><% games.each do |game| %><tr><td><%= game.quiz.title %></td><td><%= game.join_code %></td><td><span class="status-pill <%= game.status %>"><%= { 'waiting' => 'Aguardando', 'running' => 'Em andamento', 'finished' => 'Finalizada', 'cancelled' => 'Cancelada' }[game.status] %></span></td><td><%= game.created_at.strftime('%d/%m/%Y %H:%M') %></td><td><%= link_to 'Abrir sala', teacher_game_session_path(game) %> · <%= link_to 'Relatório', report_teacher_game_session_path(game) %></td></tr><% end %></tbody></table><% if games.empty? %><p>Nenhuma partida ainda.</p><% end %></div>
