<div class="heading"><div><p class="eyebrow">OFICINA DE DESAFIOS COM IA</p><h1><%= @draft.status == 'ready' ? 'Revise seu novo desafio' : 'Seu pedido de quiz' %></h1><p><%= @draft.topic %> · <%= @draft.subject %> · <%= @draft.grade_level %></p></div><%= link_to 'Todos os pedidos', new_teacher_ai_quiz_path, class: 'button secondary' %></div>
<div class="actions"><%= button_to 'Excluir pedido de IA', teacher_ai_quiz_path(@draft), method: :delete, class: 'danger-button', data: { turbo_confirm: 'Excluir este pedido e suas sugestões? Um quiz já salvo será mantido. Se a IA estiver gerando, o lote atual pode terminar, mas o resultado será descartado.' } %></div>
<% if %w[queued processing].include?(@draft.status) %>
  <section class="card empty-state" data-controller="ai-generation" data-ai-generation-url-value="<%= state_teacher_ai_quiz_path(@draft) %>"><span aria-hidden="true">✦</span><h2 data-ai-generation-target="title"><%= @draft.status == 'queued' ? 'Seu pedido está na fila' : 'Preparando as questões…' %></h2><p data-ai-generation-target="message" role="status">Você pode sair desta página e voltar pelos seus pedidos. O quiz só será salvo após sua revisão.</p><p>Uma geração por vez, com internet no servidor. A IA tenta gerar o quiz completo e, se necessário, solicita apenas as questões que faltam. Durante partidas em andamento, a fila aguarda.</p><%= link_to 'Voltar ao painel', teacher_quizzes_path, class: 'button secondary' %></section>
<% elsif @draft.status == 'failed' %>
  <section class="card"><h2>Não foi possível gerar desta vez</h2><p role="alert"><%= @draft.error_message %></p><%= link_to 'Fazer novo pedido', new_teacher_ai_quiz_path, class: 'button' %></section>
<% elsif @draft.status == 'imported' %>
  <section class="card"><h2>Seu quiz já foi salvo</h2><p>A revisão foi concluída. Você pode continuar editando no quiz.</p><%= link_to 'Abrir quiz →', teacher_quiz_path(@draft.quiz), class: 'button' %></section>
<% elsif @draft.status == 'ready' %>
  <div class="notice">Sugestão gerada por IA: confira a precisão dos conteúdos e a adequação à turma. Nada foi adicionado aos seus quizzes ainda.</div>
  <%= form_with url: import_teacher_ai_quiz_path(@draft) do %>
    <section class="card"><%= label_tag 'content_title', 'Título' %><%= text_field_tag 'content[title]', @review['title'], required: true, maxlength: 160 %><%= label_tag 'content_description', 'Descrição' %><%= text_area_tag 'content[description]', @review['description'], maxlength: 3000 %></section>
    <% questions = @review['questions'].is_a?(Hash) ? @review['questions'].sort_by { |key, _| key.to_i }.map(&:last) : @review['questions'] %>
    <% Array(questions).first(20).each_with_index do |question, index| %>
      <section class="card"><p class="eyebrow">QUESTÃO <%= index + 1 %></p>
        <%= label_tag "ai_statement_#{index}", 'Enunciado' %><%= text_area_tag "content[questions][#{index}][statement]", question['statement'], id: "ai_statement_#{index}", required: true, maxlength: 3000 %>
        <%= label_tag "ai_time_#{index}", 'Tempo em segundos' %><%= number_field_tag "content[questions][#{index}][time_limit_seconds]", question['time_limit_seconds'], id: "ai_time_#{index}", min: 10, max: 180, required: true %>
        <% Array(question['choices']).each_with_index do |choice, choice_index| %><%= label_tag "ai_choice_#{index}_#{choice_index}", "Alternativa #{('A'.ord + choice_index).chr}" %><%= text_field_tag "content[questions][#{index}][choices][]", choice, id: "ai_choice_#{index}_#{choice_index}", required: true, maxlength: 1000 %><% end %>
        <%= label_tag "ai_correct_#{index}", 'Alternativa correta' %><%= select_tag "content[questions][#{index}][correct_index]", options_for_select([['A', 0], ['B', 1], ['C', 2], ['D', 3]], question['correct_index']), id: "ai_correct_#{index}", required: true %>
      </section>
    <% end %>
    <section class="card"><label class="check"><%= check_box_tag :reviewed, '1', false, required: true %> Revisei os enunciados, as alternativas e o gabarito.</label><%= submit_tag 'Salvar quiz revisado', data: { turbo_submits_with: 'Salvando…' } %></section>
  <% end %>
<% end %>
